:root{--bg:#f5f7fb;--p:#fff;--line:#dce5f3;--text:#172033;--muted:#667085;--b:#2457ff;--g:#0f9f6e;--w:#f59e0b;--r:#e11d48;--sh:0 18px 45px #1f31521a}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 0 0,#eef6ff,#f6f8fc 45%,#f5f7fb);font-family:Inter,Segoe UI,Arial,sans-serif;color:var(--text)}.sidebar{position:fixed;left:0;top:0;bottom:0;width:270px;background:linear-gradient(#fff,#f6f9ff);border-right:1px solid var(--line);padding:16px;overflow:auto}.brand{display:flex;gap:12px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:18px;padding:12px;box-shadow:var(--sh);margin-bottom:14px}.brand img{width:46px;height:46px;object-fit:contain}.brand small{display:block;color:var(--muted)}.nav{width:100%;border:0;background:transparent;text-align:left;padding:10px 12px;border-radius:12px;font-weight:700;color:#344054;cursor:pointer}.nav:hover,.nav.active{background:#eaf1ff;color:#143690}.status{display:flex;gap:8px;align-items:center;color:var(--muted);font-size:12px;margin:16px 8px}#apiDot{width:10px;height:10px;border-radius:50%;background:#999;display:inline-block}#apiDot.good{background:var(--g)}#apiDot.bad{background:var(--r)}main{margin-left:270px;padding:18px 22px 50px}header{position:sticky;top:12px;z-index:3;background:#ffffffe6;backdrop-filter:blur(14px);border:1px solid var(--line);border-radius:24px;padding:14px 18px;display:flex;justify-content:space-between;align-items:center;box-shadow:var(--sh)}h1{margin:0;font-size:22px}p{margin:0;color:var(--muted)}.tab{display:none;margin-top:18px}.tab.show{display:block}.btn{border:1px solid var(--line);background:#fff;border-radius:12px;padding:9px 13px;font-weight:800;cursor:pointer;color:#24324d}.btn.primary{background:linear-gradient(135deg,var(--b),#1746cc);color:#fff;border-color:transparent}.btn.small{font-size:12px;padding:6px 9px}.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:14px}.panel{grid-column:span 3;background:#fff;border:1px solid var(--line);border-radius:22px;padding:16px;box-shadow:var(--sh)}.wide{grid-column:span 12}.half{grid-column:span 6}.kpi h4{margin:0 0 8px;color:var(--muted);font-size:12px;text-transform:uppercase}.num{font-size:28px;font-weight:900}.good .num{color:var(--g)}.warn .num{color:var(--w)}.bad .num{color:var(--r)}.hero{background:linear-gradient(135deg,#fff,#eef5ff 65%,#e7fbff);border:1px solid var(--line);border-radius:28px;padding:22px;box-shadow:var(--sh);position:relative;overflow:hidden}.hero:after{content:"";position:absolute;right:-60px;top:-80px;width:240px;height:240px;border-radius:50%;background:radial-gradient(circle,#2457ff40,transparent 60%);animation:orb 8s ease-in-out infinite}.hero h2{margin:6px 0;font-size:34px}.badge,.pill{display:inline-flex;border-radius:999px;padding:4px 9px;font-size:11px;font-weight:900}.badge{background:#eef6ff;color:#1f4aac;border:1px solid #c9ddff}.pill.fresh{background:#e8fff6;color:#087a53}.pill.stale{background:#fff7e6;color:#9a5b00}.pill.server{background:#f1f5f9;color:#475569}.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px;perspective:900px}.card3d{border:1px solid var(--line);background:linear-gradient(145deg,#fff,#f3f7ff);border-radius:20px;padding:14px;text-align:left;box-shadow:0 15px 34px #2457ff1a;cursor:pointer;transition:.22s}.card3d:hover{transform:translateY(-5px) rotateX(3deg) rotateY(-3deg)}.small,.hint{color:var(--muted);font-size:12px}.meter{height:8px;background:#e5ecfa;border-radius:99px;overflow:hidden;margin-top:10px}.meter span{display:block;height:100%;background:linear-gradient(90deg,var(--b),#19a7ce)}.toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:14px}select,input{border:1px solid var(--line);border-radius:12px;padding:9px 11px;background:#fff;min-height:38px}select{min-width:310px}.table{overflow:auto;border:1px solid var(--line);border-radius:18px;background:#fff}table{width:100%;border-collapse:collapse;font-size:13px}th,td{padding:10px 12px;border-bottom:1px solid #edf1f7;text-align:left;vertical-align:top}th{background:#f7f9ff;color:#475467;font-size:12px}.mini{border:1px solid var(--line);background:#f9fbff;border-radius:16px;padding:12px}.detail{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px}.k{font-size:11px;text-transform:uppercase;color:var(--muted);font-weight:900}.v{font-weight:850;margin-top:4px;word-break:break-word}.note,.empty{border:1px dashed #b8c9ee;background:#f8fbff;border-radius:16px;padding:12px;color:#475467;margin:10px 0}footer{text-align:center;color:var(--muted);font-size:12px;margin-top:22px}.toast{position:fixed;right:18px;bottom:18px;background:#111827;color:#fff;padding:12px 14px;border-radius:14px;box-shadow:var(--sh);opacity:0;transform:translateY(20px);transition:.2s;z-index:20}.toast.show{opacity:1;transform:translateY(0)}@keyframes orb{50%{transform:translateY(24px)}}@media(max-width:900px){.sidebar{position:relative;width:auto}.main,main{margin-left:0}.panel,.half{grid-column:span 12}header{position:relative;top:0}select,input{width:100%;min-width:0}}